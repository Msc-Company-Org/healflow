# HealFlow - Environment Variables Template
# Copy to .env.local for local development

# GitHub App / Webhook
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_TOKEN=ghp_your_github_personal_or_app_token

# IBM Bob 2.0 Integration
IBM_BOB_API_KEY=your_ibm_bob_api_key_here
IBM_BOB_ENDPOINT=https://api.ibm.com/bob/v2

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=file:./data/healflow.db
